<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar / AppBar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarProfile"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="User Profile"
                app:titleTextColor="@color/white"
                android:background="@color/blue_primary" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Profile Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imgProfileAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_meditrack_logo"
                    android:padding="12dp"
                    android:background="@drawable/circle_background_unselected"
                    android:contentDescription="Profile Picture" />

                <TextView
                    android:id="@+id/txtProfileUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role: Patient"
                    android:textSize="14sp"
                    android:textColor="@color/blue_primary"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:background="#E3F2FD"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/txtProfilePhoneOrEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Managed by Meditrack"
                    android:textSize="13sp"
                    android:textColor="@color/text_grey"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Overview for Patient -->
        <LinearLayout
            android:id="@+id/layoutPatientStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#E8F5E9"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtProfileAdherence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Adherence"
                        android:textSize="12sp"
                        android:textColor="#2E7D32" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#E3F2FD"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtProfileTotalMedications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Medicines"
                        android:textSize="12sp"
                        android:textColor="#1565C0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- SOS Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFEBEE"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#D32F2F"
                    android:contentDescription="SOS Warning" />

                <TextView
                    android:id="@+id/txtProfileSosAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active SOS Emergency Alert Triggered!"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Doctor Note Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileDoctorNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtProfileDoctorNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctor's Advice / Note"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#F57F17" />

                <TextView
                    android:id="@+id/txtProfileDoctorNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No active notes"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileWriteNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Write Prescription / Note"
                app:icon="@android:drawable/ic_menu_edit"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileCallPatient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Call Patient"
                app:icon="@android:drawable/ic_menu_call"
                android:backgroundTint="#4CAF50"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                app:icon="@android:drawable/ic_lock_power_off"
                android:backgroundTint="#D32F2F"
                android:textColor="@color/white"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>